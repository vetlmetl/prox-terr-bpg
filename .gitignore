# Terraform state files (contain sensitive credentials)
*.tfstate
*.tfstate.backup

# Terraform download/cache directory
.terraform/

# Environment-specific overrides (may contain secrets or infrastructure details)
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json

# Partial backend config (bucket name / infra details) — keep .example committed
backend.hcl

# OS / editor artifacts
.DS_Store
*.log
CLAUDE.md
AGENTS.md
todo.md

# Cluster credentials exported from Terraform outputs (contain client certs/keys)
kubeconfig
kubeconfig.yaml
talosconfig
talosconfig.yaml
